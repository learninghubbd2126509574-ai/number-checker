rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Checking length and alphanumeric parameters
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Record Validation
    function isValidRecord(data) {
      return data.number is string && data.number.size() >= 5 && data.number.size() <= 30 &&
             data.status is string && (data.status == "clear" || data.status == "flagged") &&
             data.category is string && (data.category == "Fake Leader" || data.category == "Fake Lead" || data.category == "Attacker" || data.category == "Bad Behavior" || data.category == "Deleted Member" || data.category == "Other" || data.category == "None") &&
             data.note is string && data.note.size() <= 5000 &&
             data.createdBy is string &&
             data.createdByEmail is string;
    }

    // Count Record Validation
    function isValidCount(data) {
      return data.number is string && data.number.size() >= 5 && data.number.size() <= 30 &&
             data.count is int && data.count >= 0;
    }

    // Settings Validation
    function isValidSettings(data) {
      return data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 10 &&
             data.allowedEmails is list && data.allowedEmails.size() <= 100;
    }

    // Search Log Validation - Simplified for robustness
    function isValidSearchLog(data) {
      return data.number is string && 
             data.ip is string && 
             data.date is string && 
             data.time is string;
    }

    // Rules for records collection
    match /records/{recordId} {
      // Anyone can verify a single phone number via get
      allow get: if true;
      
      // Signed-in users (Google admins or PIN anonymous admins) can manage database records
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidRecord(incoming());
      allow update: if isSignedIn() && isValidRecord(incoming());
      allow delete: if isSignedIn();
    }

    // Rules for registration_counts collection
    match /registration_counts/{numberId} {
      // Anyone can load single dynamic counts
      allow get: if true;
      
      // Signed-in users can view all list counts
      allow list: if isSignedIn();
      
      // Anyone is permitted to record a new registration count entry
      allow create: if isValidCount(incoming());
      
      // Public is permitted to increment count, or admin is permitted to update counts
      allow update: if isValidCount(incoming()) || isSignedIn();
      
      // Only signed-in admin is permitted to remove records
      allow delete: if isSignedIn();
    }

    // Rules for settings collection
    match /settings/{settingId} {
      // Anyone can load, read and listen to the settings document to bootstrap & verify PIN/emails
      allow read: if true;
      
      // Allow settings document creation / bootstrap if it conforms to strict schema
      allow create: if isValidSettings(incoming());

      // Only authenticated admins are permitted to update PIN or edit allowlisted emails
      allow update: if isSignedIn() && isValidSettings(incoming());
      allow delete: if false; // Settings are permanent
    }

    // Rules for search_logs collection
    match /search_logs/{logId} {
      // Admins (and any authenticated user, including anonymous) can view and delete logs
      allow get, list, delete: if request.auth != null;
      
      // Public users (including unauthenticated) can create search logs
      allow create: if isValidSearchLog(incoming());
    }
  }
}
